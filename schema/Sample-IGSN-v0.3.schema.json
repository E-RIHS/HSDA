{
   "$schema":"http://json-schema.org/draft-07/schema#",
   "$id":"https://e-rihs.io/HSDA/schema/Sample-IGSN-v0.3.schema.json",
   "title":"Sample",
   "type":"object",
   "required":[
      "doi",
      "creators",
      "titles",
      "publisher",
      "publicationYear",
      "types"
   ],
   "properties":{
      "doi":{
         "title":"Sample identifier",
         "description":"The identifier property will be automatically populated with a DOI upon the creation of an IGSN ID. The system will assign a random DOI suffix unless a specific suffix is supplied using Fabrica or DataCite APIs.",
         "type":"string",
         "pattern":"^10[.][0-9]{4,9}[/][^\\s]+$"
      },
      "creators":{
         "title":"Sample Creators",
         "description":"The creator property contains a list of the main researcher(s) involved...in priority order. For IGSN IDs, this could be the sample collector/creator, chief scientist, curator, or even the person who deposited the sample into a repository.",
         "type":"array",
         "items":{
            "title":"Creator",
            "type":"object",
            "required":[
               "name"
            ],
            "properties":{
               "name":{
                  "type":"string"
               },
               "nameType":{
                  "$ref":"#/definitions/nameType"
               },
               "givenName":{
                  "type":"string"
               },
               "familyName":{
                  "type":"string"
               },
               "nameIdentifiers":{
                  "$ref":"#/definitions/nameIdentifiers"
               },
               "affiliation":{
                  "$ref":"#/definitions/affiliation"
               },
               "lang":{
                  "type":"string"
               }
            }
         },
         "minItems":1
      },
      "titles":{
         "title":"Sample titles or labels",
         "type":"array",
         "description":"The title property should include appropriate elements that would help find and distinguish a sample. The exact syntax is at the discretion of the IGSN ID registrant. Appropriate elements might include: The basic form of the object that is registered. For example, polished section, core, pulp, solution, dredge haul in a box, lot, or piece of material; The material or materials that compose the sample. For example, water, granite, or tissue; Local sample identifiers.",
         "items":{
            "title":"Sample title",
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "title":{
                  "type":"string"
               },
               "titleType":{
                  "$ref":"#/definitions/titleType"
               },
               "lang":{
                  "type":"string"
               }
            },
            "required":[
               "title"
            ]
         },
         "minItems":1,
         "uniqueItems":true
      },
      "publisher":{
         "title":"Publisher",
         "description":"The publisher property contains the name of the entity that holds, archives, publishes prints, distributes, releases, issues, or produces the resource. For IGSN IDs, this should be the organization registering the IGSN ID for the physical sample.",
         "type":"object",
         "additionalProperties":false,
         "properties":{
            "name":{
               "type":"string"
            },
            "publisherIdentifier":{
               "type":"string"
            },
            "publisherIdentifierScheme":{
               "type":"string"
            },
            "schemeUri":{
               "type":"string",
               "format":"uri"
            },
            "lang":{
               "type":"string"
            }
         },
         "required":[
            "name"
         ]
      },
      "publicationYear":{
         "title":"Publication Year",
         "description":"The publicationYear property should contain the year when the sample was first made available to the research community. This is likely to be the year at the time the physical sample is registered unless the sample was released before registration of its metadata record. The DataCite Metadata Schema provides the following additional guidance for the publicationYear property that is relevant to material samples: If the date of public availability cannot be determined, use the date of registration. If an embargo period has been in effect, use the date when the embargo period ends. If there is no standard publication year value, use the date that would be preferred from a citation perspective.",
         "type":"string",
         "pattern":"^[0-9]{4}$"
      },
      "types":{
         "title":"Resource types",
         "type":"object",
         "description":"The resourceType property may be populated with resource types from external ontologies or shared vocabularies. In the absence of an agreed vocabulary, the use of the terms “material sample” or “‘feature-of-interest” are strongly recommended to at least distinguish between these sampling concepts. A material sample is a specialization of a larger feature-of-interest, which is typically the collection site. For example, in the Geosciences, a feature-of-interest might be a lake, tree, cross-section, transect, or borehole. ",
         "additionalProperties":false,
         "required":[
            "resourceType",
            "resourceTypeGeneral"
         ],
         "properties":{
            "resourceType":{
               "title":"Resource Type",
               "type":"string",
               "enum":[
                  "Heritage Sample",
                  "Heritage Feature-of-Interest",
                  "Heritage Sample Collection"
               ]
            },
            "resourceTypeGeneral":{
               "type":"string",
               "const":"PhysicalObject",
               "default":"PhysicalObject"
            }
         }
      },
      "subjects":{
         "title":"Subjects, Keywords and Classification codes",
         "description":"The free-text subject property contains the 'subject, keyword, classification code, or key phrase describing the resource.' For IGSN IDs, this is the materials that compose the sample. Since materials may be categorized under different schemata, the sub-properties subjectScheme and schemeURI should also be included whenever possible.",
         "type":"array",
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "subject":{
                  "type":"string"
               },
               "subjectScheme":{
                  "type":"string"
               },
               "schemeUri":{
                  "type":"string",
                  "format":"uri"
               },
               "valueUri":{
                  "type":"string",
                  "format":"uri"
               },
               "classificationCode":{
                  "type":"string"
               },
               "lang":{
                  "type":"string"
               }
            },
            "required":[
               "subject"
            ]
         },
         "uniqueItems":true
      },
      "contributors":{
         "title":"Contributors",
         "description":"All institutions and people involved in a sample’s workflow—from collection to archival (or discarding/destruction)—may be captured in the free-text contributor property. If contributor is used, the sub-properties contributorName and contributorType are mandatory. ",
         "type":"array",
         "items":{
            "type":"object",
            "required":[
               "contributorType",
               "name"
            ],
            "properties":{
               "name":{
                  "type":"string"
               },
               "contributorType":{
                  "$ref":"#/definitions/contributorType"
               },
               "nameType":{
                  "$ref":"#/definitions/nameType"
               },
               "givenName":{
                  "type":"string"
               },
               "familyName":{
                  "type":"string"
               },
               "nameIdentifiers":{
                  "$ref":"#/definitions/nameIdentifiers"
               },
               "affiliation":{
                  "$ref":"#/definitions/affiliation"
               },
               "lang":{
                  "type":"string"
               }
            }
         }
      },
      "dates":{
         "title":"Dates",
         "description":"The date property may be used to log events relevant to the physical object. The date property requires the dateType sub-property, which must be entered from a controlled list. The 'Collected' dateType may be used to record when a sample was collected. At this time, there is no controlled list value for 'Destroyed', which may be pertinent to your material samples metadata. Pending the potential addition of an equivalent value, we advise using a date property with dateType 'Other' and 'Destroyed' in the dateInformation field.",
         "type":"array",
         "uniqueItems":true,
         "items":{
            "type":"object",
            "additionalProperties":false,
            "required":[
               "date",
               "dateType"
            ],
            "properties":{
               "date":{
                  "title":"Date",
                  "type":"string",
                  "format":"date"
               },
               "dateType":{
                  "title":"Date Type",
                  "type":"string",
                  "enum":[
                     "Accepted",
                     "Available",
                     "Collected",
                     "Created",
                     "Submitted",
                     "Updated",
                     "Withdrawn",
                     "Other"
                  ]
               },
               "dateInformation":{
                  "title":"Date Information",
                  "type":"string",
                  "$comment":"it might make sense to add 'mounted', 'consumed' and 'destroyed' to the datetime list, and programmatically change it to other when send to datacite"
               }
            }
         }
      },
      "alternateIdentifiers":{
         "title":"Alternate Identifiers",
         "description":"The alternateIdentifier property may be used to enter any other identifiers for the material sample, including local sample identifiers. For alternate identifiers that were assigned by a researcher or within a project, 'local' is the default recommended alternateIdentifierType.",
         "type":"array",
         "uniqueItems":true,
         "items":{
            "title":"Alternate Identifier",
            "type":"object",
            "additionalProperties":false,
            "required":[
               "alternateIdentifier",
               "alternateIdentifierType"
            ],
            "properties":{
               "alternateIdentifier":{
                  "type":"string"
               },
               "alternateIdentifierType":{
                  "type":"string"
               }
            }
         }
      },
      "relatedIdentifiers":{
         "title":"Related Identifiers",
         "description":"Connecting samples to one another, and to research based on them, is a primary goal of the IGSN ID. Such connections are captured through relatedIdentifier properties, which list the globally unique Identifiers assigned to related resources. It is therefore recommended that relatedIdentifier is used to the maximum extent possible and is updated on a regular basis. Sample collections should be referenced via relationType 'IsPartOf' pointing to the collection's DOI or IGSN.",
         "type":"array",
         "items":{
            "title":"Related Identifier",
            "type":"object",
            "additionalProperties":false,
            "required":[
               "relatedIdentifier",
               "relatedIdentifierType",
               "relationType"
            ],
            "properties":{
               "relatedIdentifier":{
                  "title":"Related Identifier",
                  "type":"string"
               },
               "relatedIdentifierType":{
                  "title":"Related Identifier Type",
                  "type":"string",
                  "enum":[
                     "ARK",
                     "arXiv",
                     "bibcode",
                     "DOI",
                     "EAN13",
                     "EISSN",
                     "Handle",
                     "IGSN",
                     "ISBN",
                     "ISSN",
                     "ISTC",
                     "LISSN",
                     "LSID",
                     "PMID",
                     "PURL",
                     "UPC",
                     "URL",
                     "URN",
                     "w3id"
                  ]
               },
               "relationType":{
                  "title":"Relation Type",
                  "description":"The relatedIdentifier property can be used to make connections that mirror sample hierarchies. Because the parent IGSN ID is a key element in IGSN ID metadata, it is recommended that a child (sub)sample identifies its parent using the relationType 'IsPartOf' or 'IsDerivedFrom'. Vice versa, a parent sample can identify its children using 'HasPart' or 'IsSourceOf'.",
                  "type":"string",
                  "enum":[
                     "IsCitedBy",
                     "Cites",
                     "IsCollectedBy",
                     "Collects",
                     "IsSupplementTo",
                     "IsSupplementedBy",
                     "IsContinuedBy",
                     "Continues",
                     "IsDescribedBy",
                     "Describes",
                     "HasMetadata",
                     "IsMetadataFor",
                     "HasVersion",
                     "IsVersionOf",
                     "IsNewVersionOf",
                     "IsPartOf",
                     "IsPreviousVersionOf",
                     "IsPublishedIn",
                     "HasPart",
                     "IsReferencedBy",
                     "References",
                     "IsDocumentedBy",
                     "Documents",
                     "IsCompiledBy",
                     "Compiles",
                     "IsVariantFormOf",
                     "IsOriginalFormOf",
                     "IsIdenticalTo",
                     "IsReviewedBy",
                     "Reviews",
                     "IsDerivedFrom",
                     "IsSourceOf",
                     "IsRequiredBy",
                     "Requires",
                     "IsObsoletedBy",
                     "Obsoletes"
                  ]
               },
               "relatedMetadataScheme":{
                  "title":"Related Metadata Scheme",
                  "description":"NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor",
                  "type":"string"
               },
               "schemeUri":{
                  "title":"Scheme URI",
                  "type":"string",
                  "description":"NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor",
                  "format":"uri"
               },
               "schemeType":{
                  "title":"Scheme Type",
                  "type":"string",
                  "description":"NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor"
               },
               "resourceTypeGeneral":{
                  "title":"Resource Type General",
                  "type":"string",
                  "enum":[
                     "Audiovisual",
                     "Book",
                     "BookChapter",
                     "Collection",
                     "ComputationalNotebook",
                     "ConferencePaper",
                     "ConferenceProceeding",
                     "DataPaper",
                     "Dataset",
                     "Dissertation",
                     "Event",
                     "Image",
                     "Instrument",
                     "InteractiveResource",
                     "Journal",
                     "JournalArticle",
                     "Model",
                     "OutputManagementPlan",
                     "PeerReview",
                     "PhysicalObject",
                     "Preprint",
                     "Report",
                     "Service",
                     "Software",
                     "Sound",
                     "Standard",
                     "StudyRegistration",
                     "Text",
                     "Workflow",
                     "Other"
                  ]
               }
            }
         }
      },
      "descriptions":{
         "title":"Descriptions",
         "description":"It is valuable to include additional information about a sample, particularly about its 'birth', in the free-text description property. If the description property is used, then the sub-property descriptionType is mandatory. Values for the latter are selected from a controlled list, with the most relevant for IGSN IDs being: (1) Abstract: Brief description of the resource and the context in which it was created; (2) Methods: The methodology employed for the study or research. For IGSN IDs, this is the collection method. A sample description should be included as an item in the 'descriptions' array using descriptionType 'Sample description'.",
         "$comment":"Datacite 17, with custom descriptionTypes",
         "type":"array",
         "uniqueItems":true,
         "items":{
            "type":"object",
            "additionalProperties":false,
            "required":[
               "description",
               "descriptionType"
            ],
            "properties":{
               "description":{
                  "title":"Description",
                  "type":"string",
                  "format":"textarea"
               },
               "descriptionType":{
                  "title":"Description Type",
                  "type":"string",
                  "enum":[
                     "Sample description",
                     "Sample site description",
                     "Sampling method",
                     "Reason for sampling",
                     "Other"
                  ],
                  "$comment":"The custom descriptionType values used here map to standard DataCite types as follows: 'Sample description' and 'Sample site description' should both be treated as 'Abstract'; 'Sampling method' maps to 'Methods'; and 'Reason for sampling' maps to 'Other'. Note that a 'Sample site description' can be added in the 'sample_source' custom block, so it should not be added in this 'descriptions' array. These mappings should be applied when exporting to systems that expect standard DataCite descriptionType values."
               },
               "lang":{
                  "type":"string"
               }
            }
         }
      },
      "geoLocations":{
         "title":"Geo Locations",
         "description":"For real-world geospatial locations only. Do not use for positions on an object surface — see `sample_source.sample_site_description` and `sample_site_annotations` instead. The geoLocation property is used to encode information on the 'spatial region or named place where the data was gathered or about which the data is focused.' The property can be repeated to indicate a number of different locations, and can express a location as a point, bounding box, or polygon, or simply as a free-text description",
         "type":"array",
         "uniqueItems":true,
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "geoLocationPlace":{
                  "title":"Geo Location Place",
                  "type":"string"
               },
               "geoLocationPoint":{
                  "$ref":"#/definitions/geoLocationPoint"
               },
               "geoLocationBox":{
                  "title":"Geo Location Box",
                  "type":"object",
                  "additionalProperties":false,
                  "required":[
                     "westBoundLongitude",
                     "eastBoundLongitude",
                     "southBoundLatitude",
                     "northBoundLatitude"
                  ],
                  "properties":{
                     "westBoundLongitude":{
                        "$ref":"#/definitions/longitude"
                     },
                     "eastBoundLongitude":{
                        "$ref":"#/definitions/longitude"
                     },
                     "southBoundLatitude":{
                        "$ref":"#/definitions/latitude"
                     },
                     "northBoundLatitude":{
                        "$ref":"#/definitions/latitude"
                     }
                  }
               },
               "geoLocationPolygon":{
                  "title":"Geo Location Polygon",
                  "type":"array",
                  "items":{
                     "type":"object",
                     "additionalProperties":false,
                     "properties":{
                        "polygonPoint":{
                           "$ref":"#/definitions/geoLocationPoint"
                        },
                        "inPolygonPoint":{
                           "$ref":"#/definitions/geoLocationPoint"
                        }
                     }
                  }
               }
            }
         }
      },
      "language":{
         "title":"Language",
         "description":"Primary language of this sample description. Allowed values are taken from  IETF BCP 47, ISO 639-1 language codes.",
         "type":"string"
      },
      "sizes":{
         "description":"The size of the sample. This is a list of sizes in a unit of measure. This can be width, height, depth, diameter, weight, volume, etc. Use SI units as appropriate.",
         "type":"array",
         "items":{
            "type":"string"
         },
         "uniqueItems":true
      },
      "version":{
         "title":"Version",
         "description":"The version of the sample description. Suggested practice: track major_version.minor_version.",
         "type":"string"
      },
      "rightsList":{
         "type":"array",
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "rights":{
                  "type":"string"
               },
               "rightsUri":{
                  "type":"string",
                  "format":"uri"
               },
               "rightsIdentifier":{
                  "type":"string"
               },
               "rightsIdentifierScheme":{
                  "type":"string"
               },
               "schemeUri":{
                  "type":"string",
                  "format":"uri"
               },
               "lang":{
                  "type":"string"
               }
            }
         },
         "uniqueItems":true
      },
      "fundingReferences":{
         "type":"array",
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "funderName":{
                  "type":"string"
               },
               "funderIdentifier":{
                  "type":"string"
               },
               "funderIdentifierType":{
                  "$ref":"#/definitions/funderIdentifierType"
               },
               "awardNumber":{
                  "type":"string"
               },
               "awardUri":{
                  "type":"string",
                  "format":"uri"
               },
               "awardTitle":{
                  "type":"string"
               }
            },
            "required":[
               "funderName"
            ]
         },
         "uniqueItems":true
      },
      "sample_source":{
         "title":"Sample Source",
         "type":"object",
         "description":"The source of the sample",
         "required":[
            "source_id",
            "source_type",
            "sample_site_description"
         ],
         "properties":{
            "source_id":{
               "title":"Source ID",
               "type":"string",
               "description":"The ID of the heritage object from which the sample was taken",
               "format":"uri"
            },
            "source_label":{
               "title":"Source Label",
               "type":"string",
               "description":"A short label for the source object, for display purposes."
            },
            "source_type":{
               "title":"Source Type",
               "type":"string",
               "description":"The type of heritage object from which the sample was taken",
               "enum":[
                  "painting",
                  "sculpture",
                  "book"
               ]
            },
            "sample_site_description":{
               "title":"Sample Site Description",
               "type":"string",
               "description":"A description of the location of the sample on the source object"
            },
            "sample_site_annotation_url":{
               "title":"Sample Site Annotations",
               "description":"A URL to document to location of the site relative to an image of the source. It is recommended to use a link to a IIIF manifest, or a PID landing page for further documentation.",
               "type":"string",
               "format":"uri"
            }
         }
      },
      "sample_materials":{
         "type":"array",
         "items":{
            "$ref":"#/definitions/materialEntry"
         }
      }
   },
   "definitions":{
      "affiliation":{
         "type":"array",
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "name":{
                  "type":"string"
               },
               "affiliationIdentifier":{
                  "type":"string"
               },
               "affiliationIdentifierScheme":{
                  "type":"string"
               },
               "schemeUri":{
                  "type":"string",
                  "format":"uri"
               }
            },
            "required":[
               "name"
            ]
         },
         "uniqueItems":true
      },
      "contributorType":{
         "type":"string",
         "enum":[
            "ContactPerson",
            "DataCollector",
            "DataCurator",
            "DataManager",
            "Distributor",
            "Editor",
            "HostingInstitution",
            "Producer",
            "ProjectLeader",
            "ProjectManager",
            "ProjectMember",
            "RegistrationAgency",
            "RegistrationAuthority",
            "RelatedPerson",
            "Researcher",
            "ResearchGroup",
            "RightsHolder",
            "Sponsor",
            "Supervisor",
            "WorkPackageLeader",
            "Other"
         ]
      },
      "funderIdentifierType":{
         "type":"string",
         "enum":[
            "ISNI",
            "GRID",
            "Crossref Funder ID",
            "ROR",
            "Other"
         ]
      },
      "geoLocationPoint":{
         "title":"Geo Location Point",
         "type":"object",
         "additionalProperties":false,
         "required":[
            "pointLongitude",
            "pointLatitude"
         ],
         "properties":{
            "pointLongitude":{
               "$ref":"#/definitions/longitude"
            },
            "pointLatitude":{
               "$ref":"#/definitions/latitude"
            }
         }
      },
      "latitude":{
         "type":"number",
         "maximum":90,
         "minimum":-90
      },
      "longitude":{
         "type":"number",
         "maximum":180,
         "minimum":-180
      },
      "nameIdentifiers":{
         "type":"array",
         "items":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
               "nameIdentifier":{
                  "type":"string"
               },
               "nameIdentifierScheme":{
                  "type":"string"
               },
               "schemeUri":{
                  "type":"string",
                  "format":"uri"
               }
            },
            "required":[
               "nameIdentifier",
               "nameIdentifierScheme"
            ]
         },
         "uniqueItems":true
      },
      "nameType":{
         "type":"string",
         "enum":[
            "Organizational",
            "Personal"
         ]
      },
      "titleType":{
         "type":"string",
         "enum":[
            "AlternativeTitle",
            "Subtitle",
            "TranslatedTitle",
            "Other"
         ]
      },
      "sampleSiteAnnotation":{
         "type":"object",
         "description":"A structured reference to an annotation locating the sample site on an image of the source object.",
         "properties":{
            "annotation_id":{
               "type":"string",
               "format":"uri",
               "description":"URI of the annotation (e.g. WebAnnotation, IIIF)."
            },
            "image_id":{
               "type":"string",
               "format":"uri",
               "description":"URI of the annotated image or canvas."
            },
            "selector_type":{
               "type":"string",
               "enum":[
                  "FragmentSelector",
                  "SvgSelector",
                  "Other"
               ],
               "description":"Type of selector used in the annotation."
            },
            "selector_value":{
               "type":"string",
               "description":"Selector value (e.g. coordinate fragment, SVG path)."
            }
         },
         "required":[
            "annotation_id"
         ]
      },
      "materialEntry":{
         "type":"object",
         "properties":{
            "material":{
               "type":"string",
               "enum":[
                  "oil",
                  "tempera",
                  "watercolour",
                  "acrylic",
                  "gouache",
                  "ink",
                  "graphite",
                  "pencil",
                  "charcoal",
                  "pastel",
                  "other"
               ]
            },
            "confidence":{
               "type":"string",
               "enum":[
                  "high",
                  "medium",
                  "low",
                  "unknown"
               ]
            },
            "method":{
               "type":"object",
               "description":"The method used to identify the material.",
               "properties":{
                  "method_id":{
                     "type":"string",
                     "format":"uri"
                  },
                  "method_label":{
                     "type":"string"
                  },
                  "method_type":{
                     "type":"string",
                     "enum":[
                        "invasive",
                        "non-invasive",
                        "imaging",
                        "chemical",
                        "mechanical",
                        "other"
                     ]
                  }
               },
               "anyOf":[
                  {
                     "required":[
                        "method_id"
                     ]
                  },
                  {
                     "required":[
                        "method_label"
                     ]
                  }
               ]
            }
         },
         "required":[
            "material"
         ]
      }
   }
}
