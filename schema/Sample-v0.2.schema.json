{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://e-rihs.io/HSDA/schema/Sample-IGSN-v0.2.schema.json",
    "title": "Sample",
    "type": "object",
    "required": [
        "doi",
        "creators",
        "titles",
        "publisher",
        "publicationYear",
        "types",
        "sample_description",
        "collection_id"
    ],
    "properties": {
        "doi": {
            "title": "Sample identifier",
            "description": "The identifier property will be automatically populated with a DOI upon the creation of an IGSN ID. The system will assign a random DOI suffix unless a specific suffix is supplied using Fabrica or DataCite APIs.",
            "type": "string", 
            "pattern" : "^10[.][0-9]{4,9}[/][^\\s]+$"
        },
        "creators": {
            "title": "Sample Creators",
            "description": "The creator property contains a list of the main researcher(s) involved...in priority order. For IGSN IDs, this could be the sample collector/creator, chief scientist, curator, or even the person who deposited the sample into a repository.",
            "type": "array",
            "items": {
                "title": "Creator",
                "type": "object",
                "required": ["name"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "nameType": {
                        "$ref": "#/definitions/nameType"
                    },
                    "givenName": {
                        "type": "string"
                    },
                    "familyName": {
                        "type": "string"
                    },
                    "nameIdentifiers": {
                        "$ref": "#/definitions/nameIdentifiers"
                    },
                    "affiliation": {
                        "$ref": "#/definitions/affiliation"
                    },
                    "lang": {
                        "type": "string"
                    }
                }
            },
            "minItems": 1
        },
        "titles": {
            "title": "Sample titles or labels",
            "type": "array",
            "description": "The title property should include appropriate elements that would help find and distinguish a sample. The exact syntax is at the discretion of the IGSN ID registrant. Appropriate elements might include: The basic form of the object that is registered. For example, polished section, core, pulp, solution, dredge haul in a box, lot, or piece of material; The material or materials that compose the sample. For example, water, granite, or tissue; Local sample identifiers.",
            "items": {
                "title": "Sample title",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "titleType": {
                        "$ref": "#/definitions/titleType"
                    },
                    "lang": {
                        "type": "string"
                    }
                },
                "required": ["title"]
            },
            "minItems": 1,
            "uniqueItems": true
        },
        "publisher": {
            "title": "Publisher",
            "description": "The publisher property contains the name of the entity that holds, archives, publishes prints, distributes, releases, issues, or produces the resource. For IGSN IDs, this should be the organization registering the IGSN ID for the physical sample.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type":"string"
                },
                "publisherIdentifier": {
                    "type":"string"
                },
                "publisherIdentifierScheme": {
                    "type":"string"
                },
                "schemeUri": {
                    "type":"string", 
                "format": "uri"
                },
                "lang": {
                    "type":"string"
                }
            },
            "required": ["name"]
        },
        "publicationYear": {
            "title": "Publication Year",
            "description": "The publicationYear property should contain the year when the sample was first made available to the research community. This is likely to be the year at the time the physical sample is registered unless the sample was released before registration of its metadata record. The DataCite Metadata Schema provides the following additional guidance for the publicationYear property that is relevant to material samples: If the date of public availability cannot be determined, use the date of registration. If an embargo period has been in effect, use the date when the embargo period ends. If there is no standard publication year value, use the date that would be preferred from a citation perspective.",
            "type": "string",
            "pattern": "^[0-9]{4}$"
        },
        "types": {
            "title": "Resource types",
            "type": "object",
            "description": "The resourceType property may be populated with resource types from external ontologies or shared vocabularies. In the absence of an agreed vocabulary, the use of the terms “material sample” or “‘feature-of-interest” are strongly recommended to at least distinguish between these sampling concepts. A material sample is a specialization of a larger feature-of-interest, which is typically the collection site. For example, in the Geosciences, a feature-of-interest might be a lake, tree, cross-section, transect, or borehole. ",
            "additionalProperties": false,
            "minItems": 1,
            "required": ["resourceType", "resourceTypeGeneral"],
            "properties": {
                "resourceType": {
                    "title": "Resource Type",
                    "type": "string",
                    "enum": [
                        "Heritage Sample",
                        "Heritage Feature-of-Interest",
                        "Heritage Sample Collection"
                    ]
                },
                "resourceTypeGeneral": {
                    "type": "string",
                    "const": "PhysicalObject"
                }
            }
        },
        "subjects": {
            "title": "Subjects, Keywords and Classification codes",
            "description": "The free-text subject property contains the 'subject, keyword, classification code, or key phrase describing the resource.' For IGSN IDs, this is the materials that compose the sample. Since materials may be categorized under different schemata, the sub-properties subjectScheme and schemeURI should also be included whenever possible.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "subjectScheme": {
                        "type": "string"
                    },
                    "schemeUri": {
                            "type": "string", 
                        "format": "uri"
                    },
                    "valueUri": {
                            "type": "string", 
                        "format": "uri"
                    },
                    "classificationCode": {
                            "type": "string"
                    },
                    "lang": {
                            "type": "string"
                    }
                },
                "required": ["subject"]
            },
            "uniqueItems": true
        },
        "contributors": {
            "title": "Contributors",
            "description": "All institutions and people involved in a sample’s workflow—from collection to archival (or discarding/destruction)—may be captured in the free-text contributor property. If contributor is used, the sub-properties contributorName and contributorType are mandatory. ",
            "type": "array",
            "items": {
                "type": "object",
                "required": ["contributorType", "name"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "contributorType": {
                        "$ref": "#/definitions/contributorType"
                    },
                    "nameType": {
                        "$ref": "#/definitions/nameType"
                    },
                    "givenName": {
                        "type": "string"
                    },
                    "familyName": {
                        "type": "string"
                    },
                    "nameIdentifiers": {
                        "$ref": "#/definitions/nameIdentifiers"
                    },
                    "affiliation": {
                        "$ref": "#/definitions/affiliation"
                    },
                    "lang": {
                        "type": "string"
                    }
                }
            }
        },
        "dates": {
            "title": "Dates",
            "description": "The date property may be used to log events relevant to the physical object. The date property requires the dateType sub-property, which must be entered from a controlled list. The 'Collected' dateType may be used to record when a sample was collected. At this time, there is no controlled list value for 'Destroyed', which may be pertinent to your material samples metadata. Pending the potential addition of an equivalent value, we advise using a date property with dateType 'Other' and 'Destroyed' in the dateInformation field.",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["date", "dateType"],
                "properties": {
                    "date": {
                        "title": "Date",
                        "type": "string",
                        "format": "date"
                    },
                    "dateType": {
                        "title": "Date Type",
                        "type": "string",
                        "enum": [
                            "Accepted",
                            "Available",
                            "Collected",
                            "Created",
                            "Submitted",
                            "Updated",
                            "Withdrawn",
                            "Other"
                        ]
                    },
                    "dateInformation": {
                        "title": "Date Information",
                        "type": "string",

                        "$comment": "it might make sense to add 'consumed' and 'destroyed' to the datetime list, and programmatically change it to other when send to datacite"
                        
                    }
                }
            }
        },
        "alternateIdentifiers": {
            "title": "Alternate Identifiers",
            "description": "The alternateIdentifier property may be used to enter any other identifiers for the material sample, including local sample identifiers. For alternate identifiers that were assigned by a researcher or within a project, 'local' is the default recommended alternateIdentifierType.",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "title": "Alternate Identifier",
                "type": "object",
                "additionalProperties": false,
                "required": ["alternateIdentifier", "alternateIdentifierType"],
                "properties": {
                    "alternateIdentifier": {
                        "type": "string"
                    },
                    "alternateIdentifierType": {
                        "type": "string"
                    }
                }
            }
        },
        "relatedIdentifiers": {
            "title": "Related Identifiers",
            "description": "Connecting samples to one another, and to research based on them, is a primary goal of the IGSN ID. Such connections are captured through relatedIdentifier properties, which list the globally unique Identifiers assigned to related resources. It is therefore recommended that relatedIdentifier is used to the maximum extent possible and is updated on a regular basis.",
            "type": "array",
            "items": {
                "title": "Related Identifier",
                "type": "object",
                "additionalProperties": false,
                "required": ["relatedIdentifier", "relatedIdentifierType", "relationType"],
                "properties": {
                    "relatedIdentifier": {
                        "title": "Related Identifier",
                        "type": "string"
                    },
                    "relatedIdentifierType": {
                        "title": "Related Identifier Type",
                        "type": "string",
                            "enum": [
                                "ARK",
                                "arXiv",
                                "bibcode",
                                "DOI",
                                "EAN13",
                                "EISSN",
                                "Handle",
                                "IGSN",
                                "ISBN",
                                "ISSN",
                                "ISTC",
                                "LISSN",
                                "LSID",
                                "PMID",
                                "PURL",
                                "UPC",
                                "URL",
                                "URN",
                                "w3id"
                            ]
                    },
                    "relationType": {
                        "title": "Relation Type",
                        "description": "The relatedIdentifier property can be used to make connections that mirror sample hierarchies. Because the parent IGSN ID is a key element in IGSN ID metadata, it is recommended that a child (sub)sample identifies its parent using the relationType 'IsPartOf' or 'IsDerivedFrom'. Vice versa, a parent sample can identify its children using 'HasPart' or 'IsSourceOf'.",
                        "type": "string",
                        "enum": [
                            "IsCitedBy",
                            "Cites",
                            "IsCollectedBy",
                            "Collects",
                            "IsSupplementTo",
                            "IsSupplementedBy",
                            "IsContinuedBy",
                            "Continues",
                            "IsDescribedBy",
                            "Describes",
                            "HasMetadata",
                            "IsMetadataFor",
                            "HasVersion",
                            "IsVersionOf",
                            "IsNewVersionOf",
                            "IsPartOf",
                            "IsPreviousVersionOf",
                            "IsPublishedIn",
                            "HasPart",
                            "IsReferencedBy",
                            "References",
                            "IsDocumentedBy",
                            "Documents",
                            "IsCompiledBy",
                            "Compiles",
                            "IsVariantFormOf",
                            "IsOriginalFormOf",
                            "IsIdenticalTo",
                            "IsReviewedBy",
                            "Reviews",
                            "IsDerivedFrom",
                            "IsSourceOf",
                            "IsRequiredBy",
                            "Requires",
                            "IsObsoletedBy",
                            "Obsoletes"
                        ]
                    },
                    "relatedMetadataScheme": {
                        "title": "Related Metadata Scheme",
                        "description": "NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor",
                        "type": "string"
                    },
                    "schemeUri": {
                        "title": "Scheme URI",
                        "type": "string",
                        "description": "NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor",
                        "format": "uri"
                    },
                    "schemeType": {
                        "title": "Scheme Type",
                        "type": "string",
                        "description": "NOTE: Use only with this relation pair: HasMetadata / IsMetadataFor"
                    },
                    "resourceTypeGeneral": {
                        "title": "Resource Type General",
                        "type": "string",
                        "enum": [
                            "Audiovisual",
                            "Book",
                            "BookChapter",
                            "Collection",
                            "ComputationalNotebook",
                            "ConferencePaper",
                            "ConferenceProceeding",
                            "DataPaper",
                            "Dataset",
                            "Dissertation",
                            "Event",
                            "Image",
                            "Instrument",
                            "InteractiveResource",
                            "Journal",
                            "JournalArticle",
                            "Model",
                            "OutputManagementPlan",
                            "PeerReview",
                            "PhysicalObject",
                            "Preprint",
                            "Report",
                            "Service",
                            "Software",
                            "Sound",
                            "Standard",
                            "StudyRegistration",
                            "Text",
                            "Workflow",
                            "Other"
                        ]
                    }
                }
            }
        },
        "descriptions": {
            "title": "Descriptions",
            "description": "It is valuable to include additional information about a sample, particularly about its 'birth', in the free-text description property. If the description property is used, then the sub-property descriptionType is mandatory. Values for the latter are selected from a controlled list, with the most relevant for IGSN IDs being: (1) Abstract: Brief description of the resource and the context in which it was created; (2) Methods: The methodology employed for the study or research. For IGSN IDs, this is the collection method.",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "descriptionType"],
                "properties": {
                    "description": {
                        "title": "Description",
                        "type": "string",
                        "format": "textarea"
                    },
                    "descriptionType": {
                        "title": "Description Type",
                        "type": "string",
                        "enum": [
                            "Abstract",
                            "Methods",
                            "SeriesInformation",
                            "TableOfContents",
                            "TechnicalInfo",
                            "Other"
                        ]
                    },
                    "lang": {"type": "string"}
                }
            }

        },
        "geoLocations": {
            "title": "Geo Locations",
            "description": "The geoLocation property is used to encode information on the 'spatial region or named place where the data was gathered or about which the data is focused.' The property can be repeated to indicate a number of different locations, and can express a location as a point, bounding box, or polygon, or simply as a free-text description",
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "geoLocationPlace": {
                        "title": "Geo Location Place",
                        "type": "string"
                    },
                    "geoLocationPoint": {
                        "$ref": "#/definitions/geoLocationPoint"
                    },
                    "geoLocationBox": {
                        "title": "Geo Location Box",
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["westBoundLongitude", "eastBoundLongitude", "southBoundLatitude", "northBoundLatitude"],
                        "properties": {
                            "westBoundLongitude": {"$ref": "#/definitions/longitude"},
                            "eastBoundLongitude": {"$ref": "#/definitions/longitude"},
                            "southBoundLatitude": {"$ref": "#/definitions/latitude"},
                            "northBoundLatitude": {"$ref": "#/definitions/latitude"}
                        }
                    },
                    "geoLocationPolygon": {
                        "title": "Geo Location Polygon",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "polygonPoint": {"$ref": "#/definitions/geoLocationPoint"},
                                "inPolygonPoint": {"$ref": "#/definitions/geoLocationPoint"}
                            }
                        }
                    }
                }
            }
        },




        
        "$comment": "The following properties are in the datacite schema, but not in the IGSN recommendations: 9 lang, 13 size, 14 format, 15 version, 16 rights, 19 fundingReference, 20 relatedItem",




        "$comment": "The following properties were in our version 0.1 schema, but need to be analysed",


        "sample_description": {
            "title": "Sample Description",
            "type": "string",
            "description": "A description of the sample"
        },
        "purpose": {
            "title": "Purpose",
            "type": "string",
            "description": "The purpose of sampling"
        },
        "collection_id": {
            "title": "Collection ID",
            "type": "string",
            "description": "The current location of the sample",
            "format": "uri"
        },
        "sample_source": {
            "title": "Sample Source",
            "type": "object",
            "description": "The source of the sample",
            "required": [
                "source_id",
                "source_type",
                "sampling_location_description"
            ],
            "properties": {
                "source_id": {
                    "title": "Source ID",
                    "type": "string",
                    "description": "The ID of the heritage object from which the sample was taken",
                    "format": "uri"
                },
                "source_type": {    
                    "title": "Source Type",
                    "type": "string",
                    "description": "The type of heritage object from which the sample was taken",
                    "enum": ["painting", "sculpture", "book"]
                },
                "sample_site_description": {
                    "title": "Sample Site Description",
                    "type": "string",
                    "description": "A description of the location of the sample on the source object"
                },
                "sample_site_annotations": {
                    "title": "Sample Site Annotations",
                    "type": "array",
                    "items": {
                        "title": "Sample Site Annotation ID",
                        "type": "string",
                        "description": "The ID of the annotation of the sampling location on the source object. The annotation is referencing a position on an image or map of the source.",
                        "format": "uri"      
                    }
                }
            }
        },
        "sample_materials": {
            "title": "Sample Materials",
            "type": "array",
            "items": {
                "title": "Sample Material",
                "type": "string",
                "enum": ["oil", "tempera", "watercolour", "acrylic", "gouache", "ink", "graphite", "pencil", "charcoal", "pastel", "other"]
            }
        },
        "sampling_event_id": {
            "title": "Sampling Event ID",
            "type": "string",
            "description": "The ID of the event of sampling the sample",
            "format": "uri"
        },
        "sample_status": {
            "title": "Sample Status",
            "type": "array",
            "description": "The overall status of the sample, described at a consequtive list of statuses and events in time",
            "items": {
                "title": "Sample Status",
                "description": "The status of the sample at a given time",
                "type": "object",
                "required": [
                    "status",
                    "date"
                ],
                "properties": {
                    "status": {
                        "title": "Status",
                        "description": "The status of the sample at a given time",
                        "type": "string",
                        "enum": ["mounted", "unmounted", "polished", "unpolished", "stained", "in solution"]
                    },
                    "date": {
                        "title": "Date",
                        "description": "The date and time of the sampling event, in ISO 8601 format",
                        "type": "string",
                        "format": "date-time"
                    },
                    "date_precision": {
                        "title": "Date Precision",
                        "description": "The precision of the date, as defined in https://www.wikidata.org/wiki/Help:Dates",
                        "type": "string",
                        "enum": [
                            "0 - billion years",
                            "1 - hundred million years", 
                            "2 - ten million years",
                            "3 - million years  ",
                            "4 - hundred thousand years",
                            "5 - ten thousand years",
                            "6 - thousand years",
                            "7 - century",
                            "8 - decade",
                            "9 - year",
                            "10 - month",
                            "11 - day",
                            "12 - hour",
                            "13 - minute",
                            "14 - second"
                        ]
                    },
                    "event_id": {
                        "title": "Event ID",
                        "type": "string",
                        "description": "The ID of the process, modification or treatment of the sample",
                        "format": "uri"
                    }   
                }
            }
        }
    },





    "definitions": {
        "affiliation": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {"type": "string"},
                    "affiliationIdentifier": {"type": "string"},
                    "affiliationIdentifierScheme": {"type": "string"},
                    "schemeUri": {"type": "string", "format": "uri"}
                },
                "required": ["name"]
            },
            "uniqueItems": true
        },
        "contributorType": {
            "type": "string",
            "enum": [
                "ContactPerson",
                "DataCollector",
                "DataCurator",
                "DataManager",
                "Distributor",
                "Editor",
                "HostingInstitution",
                "Producer",
                "ProjectLeader",
                "ProjectManager",
                "ProjectMember",
                "RegistrationAgency",
                "RegistrationAuthority",
                "RelatedPerson",
                "Researcher",
                "ResearchGroup",
                "RightsHolder",
                "Sponsor",
                "Supervisor",
                "WorkPackageLeader",
                "Other"
            ]
        },
        "geoLocationPoint": {
            "title": "Geo Location Point",
            "type": "object",
            "additionalProperties": false, 
            "required": ["pointLongitude", "pointLatitude"],
            "properties": {
                "pointLongitude": {"$ref": "#/definitions/longitude"},
                "pointLatitude": {"$ref": "#/definitions/latitude"}
            }
        },
        "latitude": {
            "type": "number",
             "maximum": 90,
             "minimum": -90
        },
        "longitude": {
            "type": "number",
             "maximum": 180,
             "minimum": -180
        },
        "nameIdentifiers": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "nameIdentifier": {"type": "string"},
                    "nameIdentifierScheme": {"type": "string"},
                    "schemeUri": {"type": "string", "format": "uri"}
                },
                "required": ["nameIdentifier", "nameIdentifierScheme"]
            },
            "uniqueItems": true
        },
        "nameType": {
            "type": "string",
            "enum": [
                "Organizational",
                "Personal"
            ]
        },
        "titleType": {
            "type": "string",
            "enum": [
                "AlternativeTitle",
                "Subtitle",
                "TranslatedTitle",
                "Other"
            ]
        }
    }
}
